# Copie para .env e preencha. Nenhum valor real entra neste arquivo.

# Banco. Caminho do arquivo SQLite, relativo à raiz do projeto.
DATABASE_URL="file:./dev.db"

# Segredo de assinatura do JWT. Gere o seu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Tempo de vida do token de acesso, em segundos.
JWT_TTL_SEGUNDOS="900"

# A seed de demonstração (npm run db:seed) cria contas com senha conhecida e só roda com esta
# permissão. Ela é do ambiente local: nunca a defina em produção.
SEED_DE_DEMONSTRACAO="permitida"
